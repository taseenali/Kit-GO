# Secrets — never commit
.env
*.env.local
# If secrets live in a subdirectory (e.g. an app/ folder), add that path
# explicitly too -- a nested .env is NOT automatically covered by the
# bare ".env" pattern above in every git version/config:
# {{SECRETS_PATH}}

# Generated/derived/raw data — never commit; should be regeneratable from
# a documented process, not something git holds. Delete this block if the
# project has no such directory.
{{DATA_DIR}}/

# Run-artifact logs — regenerated by every real run, not meant to be tracked
*.log

# Python (delete/adjust if this isn't a Python project)
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# Node (delete/adjust if this isn't a Node project)
node_modules/
dist/
.next/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
